#!/usr/bin/env python3
import os
import sys
import tkinter as tk
from tkinter import filedialog, messagebox

# --- CONFIGURATION ---

# Directories to ignore
SKIP_DIRS = {
    '.git', '__pycache__', 'node_modules', '.idea', '.vscode',
    'venv', 'env', 'build', 'dist', 'target', '.next', '.nuxt'
}

# Specific filenames to ignore (usually huge auto-generated files)
SKIP_FILES = {
    'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml',
    'Cargo.lock', 'composer.lock', '.DS_Store', 'Thumbs.db'
}

# Extensions to ignore (binary-ish or usually irrelevant assets)
SKIP_EXTENSIONS = {
    '.png', '.jpg', '.jpeg', '.gif', '.ico', '.svg',
    '.woff', '.woff2', '.ttf', '.eot', '.mp4', '.mp3',
    '.zip', '.tar', '.gz', '.pyc', '.exe', '.dll', '.so', '.dylib'
}

# --- HELPER FUNCTIONS ---

def is_text_file(file_path):
    """
    Determines if a file is text or binary.
    Checks extension first, then checks for null bytes.
    """
    filename = os.path.basename(file_path)
    _, ext = os.path.splitext(filename)

    if filename in SKIP_FILES:
        return False
    if ext.lower() in SKIP_EXTENSIONS:
        return False

    try:
        # Read the first 8KB to check for binary characteristics
        with open(file_path, 'rb') as f:
            chunk = f.read(8192)
        if b'\0' in chunk:
            return False
        return True
    except Exception:
        return False

def get_language(filename):
    """Returns the markdown language tag based on file extension."""
    ext = os.path.splitext(filename)[1].lower()
    mapping = {
        '.sh': 'bash', '.py': 'python', '.js': 'javascript', '.jsx': 'javascript',
        '.java': 'java', '.c': 'c', '.cpp': 'cpp', '.h': 'c', '.hpp': 'cpp',
        '.html': 'html', '.css': 'css', '.scss': 'css', '.json': 'json',
        '.xml': 'xml', '.php': 'php', '.rb': 'ruby', '.go': 'go', '.md': 'markdown',
        '.txt': 'text', '.sql': 'sql', '.yaml': 'yaml', '.yml': 'yaml',
        '.ts': 'typescript', '.tsx': 'typescript', '.rs': 'rust',
        '.kt': 'kotlin', '.swift': 'swift', '.bat': 'batch', '.ps1': 'powershell',
        '.lua': 'lua', '.r': 'r', '.dart': 'dart', '.toml': 'toml'
    }
    return mapping.get(ext, '')

def get_files_recursive(paths):
    text_files = []
    skipped_count = 0

    paths = [os.path.abspath(p) for p in paths]

    for path in paths:
        if os.path.isfile(path):
            if is_text_file(path):
                text_files.append(path)
            else:
                skipped_count += 1
        elif os.path.isdir(path):
            for root, dirs, files in os.walk(path):
                # Modify dirs in-place to skip specific folders
                dirs[:] = [d for d in dirs if d not in SKIP_DIRS]

                for f in files:
                    full_path = os.path.join(root, f)
                    if is_text_file(full_path):
                        text_files.append(full_path)
                    else:
                        skipped_count += 1

    return sorted(list(set(text_files))), skipped_count

def copy_to_clipboard(root, text):
    root.clipboard_clear()
    root.clipboard_append(text)
    root.update()

# --- MAIN LOGIC ---

def main():
    root = tk.Tk()
    root.withdraw() # Hide the main window

    input_paths = []
    base_directory = os.getcwd()

    # 1. Input Handling
    if len(sys.argv) > 1:
        input_paths = sys.argv[1:]
    else:
        choice = messagebox.askyesno(
            "Select Source",
            "Yes = Select a Folder (Recursive)\nNo  = Select Specific File(s)"
        )
        if choice:
            selected_dir = filedialog.askdirectory(initialdir=base_directory)
            if selected_dir:
                input_paths = [selected_dir]
                base_directory = selected_dir
        else:
            selected_files = filedialog.askopenfilenames(initialdir=base_directory)
            if selected_files:
                input_paths = list(selected_files)
                base_directory = os.path.dirname(selected_files[0])

    if not input_paths:
        return

    # 2. Processing
    final_files, skipped_binary = get_files_recursive(input_paths)

    if not final_files:
        messagebox.showerror("Error", "No text files found to process.")
        return

    # 3. formatting for LLM Parsing
    clipboard_parts = []

    # A. PROJECT CONTEXT (File Tree)
    # This helps the LLM understand relationships between files
    clipboard_parts.append("# Project Context")
    clipboard_parts.append(" The following files are included in this context:\n")
    for file_path in final_files:
        try:
            rel_path = os.path.relpath(file_path, base_directory)
        except ValueError:
            rel_path = file_path
        clipboard_parts.append(f"- {rel_path}")
    clipboard_parts.append("\n---\n") # Separator

    # B. FILE CONTENTS
    for file_path in final_files:
        try:
            # Determine display path
            try:
                display_path = os.path.relpath(file_path, base_directory)
            except ValueError:
                display_path = file_path

            language = get_language(file_path)

            with open(file_path, 'r', encoding='utf-8', errors='replace') as f:
                content = f.read()

            # FORMATTING LOGIC
            # 1. '### ' header (Markdown Heading 3)
            # 2. Code block with language
            # 3. Horizontal rule at the end to create a clean cut
            entry = (
                f"### {display_path}\n"
                f"```{language}\n"
                f"{content}\n"
                f"```\n"
            )
            clipboard_parts.append(entry)

        except Exception as e:
            print(f"Error reading {file_path}: {e}")

    final_text = "\n".join(clipboard_parts)

    # 4. Copy and Finish
    copy_to_clipboard(root, final_text)

    msg = f"Copied {len(final_files)} file(s) to clipboard."
    if skipped_binary > 0:
        msg += f"\n(Skipped {skipped_binary} binary/lock files)"

    # Auto-close the script after showing the message
    messagebox.showinfo("Success", msg)
    root.destroy()

if __name__ == "__main__":
    main()