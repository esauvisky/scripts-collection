#!/bin/bash

# Check if arguments are passed
if [ $# -gt 0 ]; then
    args=("$@")
    use_args=true
else
    use_args=false
fi

# Ask the user for a directory to search in with a default value of the current directory
directory=$(yad --entry --title="Base Directory" \
    --text="Enter the base directory for operations or starting point for selection:" \
    --entry-text="$PWD" --width=500)

# If the user cancels or enters nothing, exit
if [ $? -ne 0 ] || [ -z "$directory" ]; then
    yad --info --text="Operation canceled or no directory entered." --width=300 --timeout=3 --no-buttons &
    exit 1
fi

# Ensure the directory exists
if [ ! -d "$directory" ]; then
    yad --error --text="Directory '$directory' does not exist. Exiting." --width=400
    exit 1
fi
# Convert to absolute path to avoid issues later
directory=$(realpath "$directory")


# This array will hold the absolute paths of all individual text files to be processed
final_files_to_process=()
binary_files_skipped=0

# --- NEW FUNCTION TO CHECK FOR TEXT FILES ---
# Uses the 'file' command to check the MIME type.
# Returns 0 (true) if the file is a text file, 1 (false) otherwise.
is_text_file() {
    local file_path="$1"
    # Ensure file exists and is readable before checking
    if [ ! -f "$file_path" ] || [ ! -r "$file_path" ]; then
        return 1
    fi

    # Check if the MIME type starts with "text/"
    if [[ $(file -b --mime-type "$file_path") == text/* ]]; then
        return 0
    else
        return 1
    fi
}
# --- END OF NEW FUNCTION ---


if $use_args; then
    # Process the command-line arguments (assumed relative to $directory)
    for arg in "${args[@]}"; do
        # Construct full path from base directory and argument
        if [[ "$arg" == /* ]]; then
            full_path_arg="$arg"
        else
            full_path_arg="$directory/$arg"
        fi
        full_path_arg=$(realpath -m "$full_path_arg") # Resolve ., .. and //

        if [ ! -e "$full_path_arg" ]; then
            yad --error --text="The item '$arg' (resolved to '$full_path_arg') does not exist." --width=500
            exit 1
        fi

        if [ -d "$full_path_arg" ]; then
            # Argument is a directory, find all files within it
            while IFS= read -r -d $'\0' found_file; do
                if is_text_file "$found_file"; then
                    final_files_to_process+=("$found_file")
                else
                    ((binary_files_skipped++))
                fi
            done < <(find "$full_path_arg" -type f ! -path "*/.git/*" -print0)
        elif [ -f "$full_path_arg" ]; then
            # Argument is a file, check if it's text
            if is_text_file "$full_path_arg"; then
                final_files_to_process+=("$full_path_arg")
            else
                ((binary_files_skipped++))
            fi
        else
            yad --error --text="The item '$arg' (resolved to '$full_path_arg') is not a regular file or directory." --width=500
            exit 1
        fi
    done
else
    # No arguments: Use yad --file for interactive selection
    selected_paths_raw=$(yad --file --multiple \
        --title="Select Files and/or Directories" \
        --text="Select files or entire directories. Binary files will be ignored." \
        --filename="$directory/" --separator=$'\n' --width=800 --height=600)

    # Check if the user canceled or selected nothing
    if [ $? -ne 0 ] || [ -z "$selected_paths_raw" ]; then
        yad --info --text="Operation canceled or no selection made." --width=300 --timeout=3 --no-buttons &
        exit 1
    fi

    IFS=$'\n' # Set Internal Field Separator to newline for the loop below
    for selected_path in $selected_paths_raw; do
        if [ -z "$selected_path" ]; then
            continue
        fi

        if [ -d "$selected_path" ]; then
            # It's a directory, find all files, filtering for text files
            while IFS= read -r -d $'\0' file_in_dir; do
                if is_text_file "$file_in_dir"; then
                    final_files_to_process+=("$file_in_dir")
                else
                    ((binary_files_skipped++))
                fi
            done < <(find "$selected_path" -type f ! -path "*/.git/*" -print0)
        elif [ -f "$selected_path" ]; then
            # It's a file, check if it's text before adding
            if is_text_file "$selected_path"; then
                final_files_to_process+=("$selected_path")
            else
                ((binary_files_skipped++))
            fi
        else
            yad --warning --text="Skipping unrecognized or inaccessible item: $selected_path" --width=500
        fi
    done
    unset IFS # Reset IFS to default
fi


# Check if any file was ultimately selected/found to process
if [ ${#final_files_to_process[@]} -eq 0 ]; then
    message="No text files found to process."
    if [ "$binary_files_skipped" -gt 0 ]; then
        message+=" ($binary_files_skipped binary file(s) were ignored)"
    fi
    yad --error --text="$message Exiting." --width=400
    exit 1
fi

# Sort and remove duplicates
IFS=$'\n' readarray -t final_files_to_process < <(printf "%s\n" "${final_files_to_process[@]}" | sort -u)
unset IFS

# Initialize the string to be copied to the clipboard
clipboard_content=""

# Function to get the language identifier based on the file extension
get_language() {
    local filename=$(basename -- "$1")
    case "$filename" in
        *.sh) echo "bash" ;;
        *.py) echo "python" ;;
        *.js) echo "javascript" ;;
        *.java) echo "java" ;;
        *.c) echo "c" ;;
        *.cpp) echo "cpp" ;;
        *.h) echo "c" ;;
        *.hpp) echo "cpp" ;;
        *.html) echo "html" ;;
        *.css) echo "css" ;;
        *.json) echo "json" ;;
        *.xml) echo "xml" ;;
        *.php) echo "php" ;;
        *.rb) echo "ruby" ;;
        *.go) echo "go" ;;
        *.md) echo "markdown" ;;
        *.txt) echo "text" ;;
        *.log) echo "log" ;;
        *.sql) echo "sql" ;;
        *.yaml|*.yml) echo "yaml" ;;
        *.ts) echo "typescript" ;;
        *.rs) echo "rust" ;;
        *.kt) echo "kotlin" ;;
        *.swift) echo "swift" ;;
        # Add more extensions as needed
        *) echo "" ;; # Default to no language hint
    esac
}

# Loop through each final file path
for full_path in "${final_files_to_process[@]}"; do
    # Determine the path to display in the clipboard content
    item_for_display=""
    if [[ "$full_path" == "$directory"/* ]]; then
        item_for_display="${full_path#"$directory/"}"
    elif [ "$full_path" == "$directory" ]; then
        item_for_display="."
    fi

    if [ -z "$item_for_display" ] || [[ "$item_for_display" == /* ]]; then
        item_for_display_candidate=$(realpath --relative-to="$PWD" "$full_path" 2>/dev/null)
        if [ $? -eq 0 ] && [[ "$item_for_display_candidate" != /* ]] && [[ "$item_for_display_candidate" != "" ]]; then
            item_for_display="$item_for_display_candidate"
        else
            item_for_display=$(basename "$full_path")
        fi
    fi
    [ -z "$item_for_display" ] && item_for_display="$full_path"


    language=$(get_language "$full_path")
    clipboard_content+="$item_for_display\n\`\`\`$language\n"
    clipboard_content+="$(cat "$full_path")"
    clipboard_content+="\n\`\`\`\n\n"
done

# Copy the content to the clipboard using xclip
if echo -n "$clipboard_content" | sed 's/\\n/\n/g' | xclip -selection clipboard -i; then
    # Notify the user that the content is copied
    final_message="The content of ${#final_files_to_process[@]} text file(s) has been copied to the clipboard."
    if [ "$binary_files_skipped" -gt 0 ]; then
        final_message+="\n\nNote: $binary_files_skipped binary file(s) were ignored."
    fi
    yad --info --text="$final_message" --width=450 --timeout=5 --no-buttons &
else
    yad --error --text="Failed to copy to clipboard. Is xclip installed and configured?" --width=450
    exit 1
fi

exit 0